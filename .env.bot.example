# ============================================
# POLYMARKET BTC UP/DOWN TRADING BOT CONFIG
# ============================================
# Copy this file or rename to .env.bot
# NEVER commit real private keys!

# --- TRADING MODE ---
DRY_RUN=true              # true = simulation, false = real money
BANKROLL=2.00             # Starting capital in USD ($2 minimum)

# --- STRATEGY PARAMETERS ---
MIN_EDGE=0.05             # 5% minimum gap (model vs market)
MIN_PROB=0.87             # Markov persistence threshold
MIN_BET=0.50              # Minimum bet size ($)
MAX_BET=2.00              # Maximum bet size ($)
LOOP_INTERVAL=81          # Seconds between checks (~1 trade/81s)

# --- POLYMARKET WALLET (for LIVE mode only) ---
# Get these from your Polymarket account
PRIVATE_KEY=              # Your wallet private key (0x...)
SAFE_ADDRESS=             # Your Polymarket Safe/proxy address

# --- TELEGRAM NOTIFICATIONS (optional) ---
# Create bot via @BotFather, get chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=       # e.g. 123456:ABC-DEF1234...
TELEGRAM_CHAT_ID=         # e.g. 123456789
