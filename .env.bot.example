# ============================================
# POLYMARKET BTC UP/DOWN TRADING BOT CONFIG (V2)
# Copy to .env.bot and fill in your values
# ============================================

# --- TRADING MODE ---
DRY_RUN=true              # true = simulation, false = real trading
BANKROLL=2.00             # Starting USD capital

# --- STRATEGY ---
MIN_EDGE=0.05             # Min edge (5%) to enter
MIN_PROB=0.40             # Min EFFECTIVE prob menang sesuai arah bet (dual-mode aware)
MIN_BET=1.00              # Min bet USD (Polymarket min ~$1)
MAX_BET=2.00              # Max bet USD
LOOP_INTERVAL=81          # Seconds between ticks
STALE_MINUTES=45          # Kalau gak ada trade > X menit, refresh market cache + log warning

# Strategy mode — handle anti-persistence (mean reversion):
#   trend       = bet sama arah persistence (cocok kalau BTC trending, P>0.5)
#   contrarian  = bet ARAH BERLAWANAN persistence (cocok kalau anti-persistent, P<0.5)
#   auto        = engine pilih sendiri arah dgn edge terbesar (recommended)
STRATEGY_MODE=auto

# --- POLYMARKET V2 DEPOSIT WALLET ---
# PRIVATE_KEY = signer EOA private key (export from Polymarket)
# SAFE_ADDRESS = V2 deposit wallet address (funder, from Polymarket profile)
PRIVATE_KEY=
SAFE_ADDRESS=

# CLOB API credentials (auto-derived if empty)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- PROXY (required from US/restricted regions) ---
# Format: socks5://host:port  OR  http://user:pass@host:port
PROXY_URL=

# --- TELEGRAM (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
